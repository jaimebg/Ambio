<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Without this, Android 13+ suppresses AudioService's foreground notification: the
         mix still plays, but the transport controls the user reaches for on the lock
         screen and in the shade are simply not there, and the only way to stop playback is
         to find the app again. Requested at runtime by NotificationPermissionGate. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required for haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Keep CPU awake during playback -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".AmbioApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Ambio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ambio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Media3 MediaSessionService - system handles notification automatically -->
        <service
            android:name="com.jbgsoft.ambio.media.AudioService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService"/>
            </intent-filter>
        </service>

        <!-- Media3 routes ACTION_MEDIA_BUTTON here and starts AudioService if it is not
             already running, which is what lets the tile control playback hours after the
             app was last opened.

             Declared here rather than in feature:tile, beside the AudioService it routes
             to and whose declaration it depends on: it is app-wide plumbing, not tile
             plumbing. Headset and Bluetooth media buttons use this route too, so putting it
             in a feature module would mean unwiring that module silently removed
             hardware-button support from the whole app. media3-session's own AAR manifest
             declares no receiver, so this declaration is required and conflicts with
             nothing. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Declared here, not in feature:tile, because a Quick Settings tile must carry
             an icon and a label, and both of the right ones live in this module: the app
             name, and the monochrome tile mark beside it in res/drawable. feature:tile
             links its own resources on the release path and cannot see either, which broke
             `assembleRelease`; see that module's manifest for the detail. The tile's own
             PlaybackStateReceiver stays there — it references no resources. -->
        <service
            android:name="com.jbgsoft.ambio.feature.tile.PlaybackTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_playback"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
