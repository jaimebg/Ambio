<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- MediaButtonReceiver, which playPauseIntent targets, is declared in app/ beside
             AudioService: it is app-wide plumbing whose correctness depends on that service
             declaration, and it must not disappear if this module is ever unwired.

             PlaybackTile is declared there too, for a narrower reason: a Quick Settings
             tile must carry android:icon and android:label, and the only sensible values
             are the launcher icon and the app name — both owned by app/. Referencing them
             from here compiled, because the manifests merge before the app's resources are
             linked, but :feature:tile also links its *own* resources on the release path
             and failed there: `assembleRelease` broke on "resource mipmap/ic_launcher not
             found" while `bundleRelease` — the only release task CI runs — passed, so the
             breakage stayed invisible. Do not move the declaration back without giving
             this module resources it actually owns. -->

        <receiver
            android:name=".PlaybackStateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jbgsoft.ambio.PLAYBACK_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The tile's cold-start path. Declared here, not in app/, because unlike
             PlaybackTile it needs no app resource: the theme is the framework's.
             taskAffinity="" keeps it out of the main task so it never drags the
             app UI to the front; showWhenLocked lets a lock-screen tap play
             without unlocking; noHistory + excludeFromRecents keep the
             millisecond-long activity out of Back and Recents. -->
        <activity
            android:name=".TilePlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>

</manifest>
